<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentUsageMISDashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to dashboard</a>
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index"><img src="~/images/Logo-Gshala.svg" alt="G-Shala" /></a>
        <div class="sidebar-caption">STUDENT USAGE MIS</div>
        <nav class="side-nav">
            <a class="selected" asp-controller="Home" asp-action="Index"><span aria-hidden="true">▦</span> MIS Dashboard</a>
            <a href="/#district" data-nav-tab="district"><span aria-hidden="true">▥</span> District Report</a>
            <a href="/#daily" data-nav-tab="daily"><span aria-hidden="true">↗</span> Daily Trends</a>
            <a href="/#school" data-nav-tab="school"><span aria-hidden="true">⌂</span> School Report</a>
            <a href="/#monthly" data-nav-tab="monthly"><span aria-hidden="true">▤</span> Monthly Report</a>
            <a href="/#yearly" data-nav-tab="yearly"><span aria-hidden="true">▤</span> Yearly Report</a>
        </nav>
        <div class="sidebar-footer">Education Department<br /><small>Student learning &amp; usage insights</small></div>
    </aside>
    <div class="app-shell">
        <header class="topbar">
            <button type="button" class="menu-toggle" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">☰</button>
            <span>G-Shala <span class="topbar-divider">/</span> Student Usage MIS</span>
            <span class="student-badge">Student dashboard</span>
        </header>
        <main id="main" class="main-content">@RenderBody()</main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
